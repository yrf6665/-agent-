# 复制本文件并改名为 .env，然后填入你自己的 Key（.env 不要上传到 Git！）
# 任意一家"OpenAI 兼容接口"的大模型都可以，下面以 DeepSeek 为例。

LLM_API_KEY=sk-在这里填你的Key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 其他可选平台（模型名以各平台官方文档为准）----
# 通义千问：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# 智谱 GLM：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-4-flash
# Kimi    ：LLM_BASE_URL=https://api.moonshot.cn/v1                         LLM_MODEL=（见官方文档）

# ---- 断网/没有 Key 时：先运行 python mock_server.py，再改用下面三行 ----
# LLM_API_KEY=mock
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=mock-model
